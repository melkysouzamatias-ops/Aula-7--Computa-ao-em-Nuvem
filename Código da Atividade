kubectl get nodes
kubectl create namespace aula7
kubectl get namespace aula7

kubectl -n aula7 create secret generic credencial-demo \
  --from-literal=senha=exemplo-123

kubectl -n aula7 get secret credencial-demo

cat > pod-secret.yaml <<'EOF'
apiVersion: v1
kind: Pod
metadata:
  name: leitor-secret
  namespace: aula7
spec:
  containers:
  - name: app
    image: busybox:1.36
    command: ['sh', '-c', 'sleep 3600']
    volumeMounts:
    - name: credencial
      mountPath: /segredos
  volumes:
  - name: credencial
    secret:
      secretName: credencial-demo
EOF

kubectl apply -f pod-secret.yaml
kubectl -n aula7 wait --for=condition=Ready pod/leitor-secret --timeout=90s
kubectl -n aula7 exec leitor-secret -- ls /segredos
kubectl -n aula7 exec leitor-secret -- cat /segredos/senha

kubectl -n aula7 create serviceaccount leitor
kubectl -n aula7 get serviceaccount leitor

kubectl -n aula7 create role consulta-pods \
  --verb=get,list --resource=pods

kubectl -n aula7 describe role consulta-pods

kubectl -n aula7 create rolebinding vinculo-leitor \
  --role=consulta-pods --serviceaccount=aula7:leitor

kubectl -n aula7 describe rolebinding vinculo-leitor

kubectl auth can-i get pods -n aula7 \
  --as=system:serviceaccount:aula7:leitor

kubectl auth can-i delete pods -n aula7 \
  --as=system:serviceaccount:aula7:leitor
